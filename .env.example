# HiroCRM — copy this file to .env and fill in the values.
# .env is git-ignored; never commit real credentials.

# Admin login (required — with these unset, authentication refuses everyone)
ADMIN_USER=admin
ADMIN_PASS=change-me

# next-auth JWT secret (required). Generate one with:
#   openssl rand -base64 32
# or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# --- Optional SLA tuning (defaults shown; controls when a lead counts as due-soon/overdue) ---
# SLA_FIRST_RESPONSE_HOURS=72
# SLA_FOLLOW_UP_HOURS=120
# SLA_RESPONSE_CAP=3

# Public origin (optional). Defaults to http://localhost:3000; set this when
# serving on any other host or port so auth callbacks resolve correctly.
# NEXTAUTH_URL=http://localhost:3000
