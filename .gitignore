# dependencies
/node_modules

# next.js
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# env — .env.example stays tracked
.env*
!.env.example

# database: SQLite file + sidecars (never committed). The smoke suite runs
# against a temp-dir scratch DB and never touches these.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# user uploads (never committed)
/data/uploads/

# test coverage
/coverage

# logs
npm-debug.log*

# OS noise
.DS_Store
Thumbs.db
Desktop.ini
*.pem

# local editor and agent settings
/.claude/
/.vscode/
/.idea/
